# Explicit source allowlist; independent of Git's tracked/untracked state.
**
!requirements.txt
!services/
!services/api/
!services/api/**/
!services/api/**/*.py
!services/api/*_alembic.ini
services/api/app/main.py
services/api/app/seed.py
services/api/alembic.ini
services/api/migrations/**
!apps/
!apps/web/
!apps/web/src/
!apps/web/src/**
!apps/web/index.html
!apps/web/package.json
!apps/web/pnpm-lock.yaml
!apps/web/pnpm-workspace.yaml
!apps/web/tsconfig.json
!apps/web/vite.config.ts
!packages/
!packages/contracts/
!packages/contracts/**/
!packages/contracts/**/*.ts
!packages/contracts/**/*.json
!deploy/
!deploy/__init__.py
!deploy/migrate.py
!deploy/docker/
!deploy/docker/*.Dockerfile
!deploy/docker/*.sh
!deploy/docker/*.conf
!deploy/docker/*.template
**/.env
**/.env.*
**/node_modules/**
**/__pycache__/**
**/.cache/**
**/*.pyc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.dump
