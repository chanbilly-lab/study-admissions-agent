# T03 production foundation only: no authentication, real catalog, private
# profiles, eligibility or plans. This configuration does not authorize release.
# Inject these values into the process; V2RuntimeSettings never loads this file.
V2_APP_ENVIRONMENT=production
V2_DATA_MODE=verified
V2_MODEL_MODE=disabled
# Optional: a protected PostgreSQL URL with independently managed credentials.
# Leave unset for the current empty foundation; there is no database connection.
# V2_DATABASE_URL=
# Remove legacy DEMO_MODE, or explicitly set false. Do not copy the M0 .env.
# DEMO_MODE=false
# No API key is required; live is not implemented and is rejected at startup.
