# 默认 PostgreSQL；只在本机演示，不使用真实学生信息。
# T03 production基础入口使用config/production-foundation.env.example所列V2_进程配置；
# 不把本M0文件作为生产配置，v2不会自动读取.env。
DATABASE_URL=postgresql+psycopg://demo:demo_local_only@127.0.0.1:5432/admissions_demo
SUPPORTED_PROVINCE=浙江
ENTRY_YEAR=2027
MODEL_MODE=mock
# M0 保留 live 接口但未接入供应商，live 请求明确失败，不回退。
LLM_API_KEY=
DEMO_MODE=true
# SQLite 仅是离线演示/测试替身，需显式启用；默认 false。
M0_SQLITE_TEST_MODE=false
# 可选：测试重放日；留空时按运行日判断后补是否过期。
# M0_ASSESSMENT_DATE=2026-09-30
VITE_API_BASE_URL=http://127.0.0.1:8000
